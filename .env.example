# Optional: add an OpenAI API key to enrich deterministic insights with an executive summary.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# SMTP settings for the daily report sender.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
REPORT_RECIPIENTS=you@example.com

# Scheduler settings. Use an IANA timezone name.
REPORT_TIMEZONE=Asia/Kolkata
REPORT_HOUR=7
REPORT_MINUTE=0
